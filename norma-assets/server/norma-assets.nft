table ip norma_assets {
  set norma_assets_targets_v4 {
    type ipv4_addr
    flags interval
    elements = {
      1.0.0.1/32,
      1.1.1.1/32,
      3.128.0.0/9,
      4.144.0.0/12,
      4.192.0.0/12,
      5.101.152.0/24,
      8.0.0.0/13,
      8.32.0.0/11,
      9.9.9.9/32,
      9.9.9.10/32,
      13.32.0.0/12,
      13.64.0.0/11,
      13.104.0.0/14,
      13.224.0.0/12,
      15.196.0.0/14,
      18.64.0.0/10,
      18.128.0.0/9,
      20.40.0.0/13,
      20.48.0.0/12,
      20.64.0.0/10,
      20.135.0.0/16,
      20.184.0.0/13,
      40.74.0.0/15,
      40.76.0.0/14,
      40.80.0.0/12,
      45.129.84.0/24,
      45.134.225.0/24,
      51.10.0.0/15,
      51.104.0.0/15,
      51.116.0.0/16,
      51.132.0.0/16,
      52.84.0.0/14,
      52.136.0.0/13,
      52.160.0.0/11,
      54.224.0.0/11,
      64.239.109.0/24,
      64.239.123.0/24,
      65.8.0.0/14,
      74.119.238.0/23,
      91.202.4.0/23,
      99.84.0.0/16,
      104.16.0.0/12,
      104.40.0.0/13,
      104.208.0.0/13,
      108.136.0.0/14,
      108.156.0.0/14,
      143.204.0.0/16,
      149.112.112.10/32,
      150.168.0.0/14,
      162.158.0.0/15,
      172.64.0.0/13,
      184.104.0.0/15,
      188.114.96.0/22,
      209.222.96.0/20
    }
  }

  set norma_assets_dynamic_v4 {
    type ipv4_addr
    flags interval
  }

  chain input {
    type filter hook input priority -50; policy accept;
    iifname "wg-assets" ip saddr 10.66.66.0/24 ip daddr 10.66.66.1 ip protocol icmp icmp type echo-request counter accept
    iifname != "lo" udp dport 41194 counter drop comment "norma-assets: WG only via loopback"
  }

  chain forward {
    type filter hook forward priority -50; policy accept;
    iifname "wg-assets" oifname "eth0" ct state established,related ip daddr @norma_assets_targets_v4 counter accept
    iifname "wg-assets" oifname "eth0" ip daddr @norma_assets_targets_v4 counter accept
    iifname "wg-assets" oifname "eth0" ct state established,related ip daddr @norma_assets_dynamic_v4 counter accept
    iifname "wg-assets" oifname "eth0" ip daddr @norma_assets_dynamic_v4 counter accept
    oifname "wg-assets" ct state established,related counter accept
    oifname "wg-assets" counter drop
    iifname "wg-assets" counter drop
  }

  chain postrouting {
    type nat hook postrouting priority srcnat; policy accept;
    oifname "eth0" ip saddr 10.66.66.0/24 ip daddr @norma_assets_targets_v4 counter masquerade comment "norma-assets: restricted egress"
    oifname "eth0" ip saddr 10.66.66.0/24 ip daddr @norma_assets_dynamic_v4 counter masquerade comment "norma-assets: dynamic domain egress"
  }
}
