[Unit]
Description=norma-assets dedicated nfqws transport desynchronization
After=network-online.target norma-assets-routing.service zapret_discord_youtube.service
Wants=network-online.target zapret_discord_youtube.service
Requires=norma-assets-routing.service
Before=wstunnel-assets-client.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/matodor/Bin/zapret-discord-youtube-linux
ExecStartPre=/usr/local/libexec/norma-assets-nfqws-firewall start
ExecStart=/home/matodor/Bin/zapret-discord-youtube-linux/nfqws --qnum=221 --dpi-desync-fwmark=0x40000000 --bind-fix4 --filter-tcp=443 --dpi-desync=fake,multisplit --dpi-desync-split-pos=1 --dpi-desync-any-protocol=1 --dpi-desync-cutoff=d3 --dpi-desync-fooling=ts --dpi-desync-repeats=8 --dpi-desync-fake-tls=/home/matodor/Bin/zapret-discord-youtube-linux/zapret-latest/bin/tls_clienthello_www_google_com.bin
ExecStopPost=/usr/local/libexec/norma-assets-nfqws-firewall stop
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
