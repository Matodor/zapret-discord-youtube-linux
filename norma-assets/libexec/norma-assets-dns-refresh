#!/usr/bin/env bash
set -Eeuo pipefail

readonly DNSCRYPT_HOST=127.0.0.1
readonly DNSCRYPT_PORT=5300
readonly READY_TIMEOUT_SEC=90

systemctl restart dnscrypt-proxy.service

ready=no
deadline=$((SECONDS + READY_TIMEOUT_SEC))
while (( SECONDS < deadline )); do
    if systemctl is-active --quiet dnscrypt-proxy.service &&
        dig +time=1 +tries=1 +short A cloudflare.com \
            "@$DNSCRYPT_HOST" -p "$DNSCRYPT_PORT" |
            grep -qE '^[0-9]+(\.[0-9]+){3}$'; then
        ready=yes
        break
    fi
    sleep 1
done

if [[ $ready != yes ]]; then
    echo "dnscrypt-proxy did not become ready on $DNSCRYPT_HOST:$DNSCRYPT_PORT within ${READY_TIMEOUT_SEC}s" >&2
    journalctl -u dnscrypt-proxy.service -n 40 --no-pager >&2 || true
    exit 1
fi

resolvectl flush-caches
